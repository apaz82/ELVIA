# Variables de entorno del backend
# Copiar este archivo como .env y completar los valores

# Claude API (Anthropic)
ANTHROPIC_API_KEY=

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=   # Solo en backend — nunca exponer al frontend

# Jooble API
JOOBLE_API_KEY=

# Resend (email)
RESEND_API_KEY=

# Servidor
PORT=3001

# URL del frontend (para configurar CORS)
FRONTEND_URL=http://localhost:5173

# Sentry — monitoreo de errores en producción (opcional, dejar vacío en desarrollo)
# Obtener DSN en: https://sentry.io → Settings → Projects → DSN
SENTRY_DSN=
