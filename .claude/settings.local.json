{
  "permissions": {
    "allow": [
      "Bash(npm run:*)",
      "Bash(npm list:*)",
      "Bash(npm install:*)",
      "Bash(node:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "WebFetch(domain:www.yeldra.com)",
      "Bash(python3)",
      "Bash(grep -v \"//.*comment\")"
    ],
    "defaultMode": "acceptEdits"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node '.claude/hooks/safety-check.js'",
            "statusMessage": "Verificando seguridad del comando..."
          }
        ]
      }
    ]
  }
}
