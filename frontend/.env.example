# Variables de entorno del frontend (Vite)
# Copiar este archivo como .env y completar los valores

# URL del backend en Railway (en desarrollo: http://localhost:3001)
VITE_API_URL=

# Supabase — claves públicas (seguras para el frontend)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Sentry — monitoreo de errores en producción (opcional, dejar vacío en desarrollo)
# Obtener DSN en: https://sentry.io → Settings → Projects → DSN
VITE_SENTRY_DSN=
